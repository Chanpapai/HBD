# คัดลอกไฟล์นี้เป็น .env.local แล้วใส่ค่าจากโปรเจกต์ Supabase ของคุณ
# Settings > API ในหน้า Supabase Dashboard

NEXT_PUBLIC_SUPABASE_URL=https://xxxxxxxx.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJhbGciOi...

# อีเมลของแอดมิน (ใช้แสดงผลเฉยๆ ไม่ใช่ค่าที่ใช้ยืนยันตัวตนจริง)
NEXT_PUBLIC_ADMIN_EMAIL_HINT=you@example.com
